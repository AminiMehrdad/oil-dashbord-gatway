meta {
  name: Create User
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CreateUser($input: CreateUserInput!) {
    createUser(createUserInput: $input) {
      statusCode
      message
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "firstName": "Frontend",
      "lastName": "Tester",
      "email": "frontend.tester@example.com",
      "phone": "+989120000000",
      "company": "Oil Project",
      "password": "StrongPass123!",
      "role": "user"
    }
  }
}
