meta {
  name: Latest Data
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:graphql {
  query LatestData {
    getLatestData {
      cost
      pressure
      temperature
      production
    }
    getDate {
      date
    }
  }
}
